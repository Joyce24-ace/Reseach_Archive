{
  "info": {
    "name": "ScholarVault API",
    "description": "Secure Academic Research & Portfolio Repository — DRF endpoints for citation engines.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://YOUR-APP.onrender.com" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Obtain JWT (Basic user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{base_url}}/api/get_token"
          }
        },
        {
          "name": "API Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.access) pm.collectionVariables.set('access_token', j.access);",
                  "if (j.refresh) pm.collectionVariables.set('refresh_token', j.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Refresh JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/refresh_token"
          }
        },
        {
          "name": "Logout (blacklist refresh)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "Publications",
      "item": [
        {
          "name": "List publications (abstract only for basic token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/publications/"
          }
        },
        {
          "name": "List publications (anonymous)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/publications/"
          }
        },
        {
          "name": "Retrieve publication by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/api/publications/1/"
          }
        },
        {
          "name": "Create publication (verified faculty)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Sample Research Paper", "type": "text" },
                { "key": "abstract", "value": "Abstract text for citation engines.", "type": "text" },
                { "key": "is_public", "value": "true", "type": "text" }
              ]
            },
            "url": "{{base_url}}/api/publications/"
          }
        }
      ]
    }
  ]
}
